# Copy to .env.local and fill in as needed. Both variables are optional —
# the site builds and runs without them.

# Server-side only. Enables live Gemini summaries in /api/gemini-assistant.
# Never prefix this with NEXT_PUBLIC_: it must not reach the browser.
GEMINI_API_KEY=

# Canonical origin used for metadataBase and OpenGraph URLs.
# Defaults to the production Vercel URL when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
