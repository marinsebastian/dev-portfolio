# Copy to .env.local and fill in as needed. Everything here is optional —
# the site builds and runs without any of it.

# ---------------------------------------------------------------------------
# AI copilot providers. All are server-side only — never prefix any of these
# with NEXT_PUBLIC_. The copilot works with any one of them configured; the
# provider selector only offers the ones whose key is actually present.
# ---------------------------------------------------------------------------

# NVIDIA NIM — https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
# NVIDIA_MODEL=z-ai/glm-5.2

# Google Gemini (OpenAI-compatible endpoint)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-lite

# OpenAI
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Which provider to prefer when the client does not pick one.
# AI_PROVIDER=nvidia

# Canonical origin used for metadataBase and OpenGraph URLs.
# Defaults to the production Vercel URL when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
